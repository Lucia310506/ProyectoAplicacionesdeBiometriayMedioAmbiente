# Fichero: .htaccess
# Autor: Lucía Díaz Murcia
# Descripción: Publica la UX y dirige GET/POST /mediciones al controlador PHP.
# Fecha: 2026-10-11
# Copyright (c) 2026 Lucía Díaz Murcia

# Document root = httpdocs (no cambiar)
DirectoryIndex src/gui/Aplicacion.html

RewriteEngine On
RewriteRule ^mediciones/?$ src/communication/mediciones.php [L,QSA]